# Environment Variables — NUTRACK
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to use for food analysis (Model Utama)
# Default: gemini-3.6-flash
GEMINI_MODEL=gemini-3.6-flash

# Model Cadangan (Fallback models, comma-separated)
# Options: gemini-2.5-flash-lite-preview-06-17, gemini-2.0-flash, gemini-1.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite-preview-06-17,gemini-2.0-flash

# ── Google Cloud / Client ─────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# ── Application ───────────────────────────────────────────────────────────────
# App name (used in metadata and branding)
NEXT_PUBLIC_APP_NAME=NUTRACK

# Base URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable AI food scanner feature
NEXT_PUBLIC_ENABLE_SCANNER=true
